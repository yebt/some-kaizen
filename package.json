{
  "name": "some-kaizen",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "bun run --cwd apps/tracker dev",
    "build": "bun run --cwd apps/tracker build && bun run --cwd apps/landing build",
    "test:unit": "bun run --cwd apps/tracker test:unit",
    "test:e2e": "bun run --cwd apps/tracker test:e2e",
    "lint": "bun run --cwd apps/tracker lint",
    "format": "bun run --cwd apps/tracker format",
    "type-check": "bun run --cwd apps/tracker type-check",
    "landing:dev": "bun run --cwd apps/landing dev",
    "landing:build": "bun run --cwd apps/landing build"
  }
}
