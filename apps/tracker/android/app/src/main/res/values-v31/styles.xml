<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Android 12 draws the launch screen itself and ignores a window background, so without
        these it shows the launcher icon on a default system colour: the wrong background for
        a fraction of a second, every single launch. Kept in values-v31 so the older path
        below API 31 stays exactly as the platform template wrote it.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
</resources>
